# =============================================================================
# Assistant IA — fichier d'exemple pour les variables d'environnement
# =============================================================================
# Copie ce fichier en `.env` (sans le `.example`) et remplis les valeurs
# dont tu as besoin. Le `.env` est charge automatiquement au demarrage par
# modules/dotenv_loader.py et a PRIORITE sur le keyring / fichiers locaux.
#
# Avantage : pour migrer le projet sur une autre machine, copie juste le
# `.env` (ou exporte ces vars dans le shell). Tu n'as RIEN a recreer dans
# le keyring de la nouvelle machine.
#
# Toutes les variables sont OPTIONNELLES. Ce qui n'est pas defini ici sera
# lu depuis le keyring (Windows Credential Manager / GNOME Keyring / Mac
# Keychain) si dispo, sinon depuis les fichiers locaux.
# =============================================================================


# --- Mots de passe d'application IMAP --------------------------------------
# Override global (s'applique a tous les utilisateurs si pas de per-user) :
#ASSISTANT_EMAIL_PASSWORD=xxxxxxxxxxxxxxxx

# Override per-user (priorite sur le global). Format :
#   ASSISTANT_EMAIL_PASSWORD_<USERNAME_EN_MAJ>=...
# Exemple pour l'utilisateur "yala" :
#ASSISTANT_EMAIL_PASSWORD_YALA=xxxxxxxxxxxxxxxx


# --- Cle de chiffrement memoire (AES-128 via Fernet) -----------------------
# La cle est en base64 url-safe (32 octets bruts -> 44 caracteres ASCII).
# Pour generer une cle :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Override global :
#ASSISTANT_CRYPTO_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=

# Override per-user :
#ASSISTANT_CRYPTO_KEY_YALA=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=


# --- Choix du LLM ----------------------------------------------------------
# Par defaut : "mistral" (cloud, necessite API_KEY dans config.py)
# Mettre "ollama" pour basculer sur un modele LOCAL (confidentialite totale,
# aucun appel cloud).
#LLM_PROVIDER=ollama
#OLLAMA_URL=http://localhost:11434/v1/chat/completions
#OLLAMA_MODEL=mistral


# --- Pieces jointes --------------------------------------------------------
# Dossier ou ranger les PJ extraites des emails (categorisees par IA).
# Par defaut : <projet>/PJ/  (cree automatiquement si absent).
# Tu peux pointer ailleurs (Documents, Dropbox, OneDrive, NAS reseau...).
#ASSISTANT_ATTACHMENTS_DIR=C:\Users\yanis\Documents\AssistantPJ
#ASSISTANT_ATTACHMENTS_DIR=D:\Archives\Mails


# --- Cles API broker (module Actions / Trading) ----------------------------
# JAMAIS dans users_db.json — lecture exclusive depuis env vars / keyring.
#
# Alpaca (US stocks). Inscription gratuite : https://alpaca.markets
# Paper = simulation gratuite, Live = vrai argent (compte US uniquement).
#ASSISTANT_ALPACA_KEY=PKxxxxxxxxxxxxxxxxxx
#ASSISTANT_ALPACA_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Variantes per-user (override) :
#ASSISTANT_ALPACA_KEY_YALA=PKxxxxxxxxxxxxxxxxxx
#ASSISTANT_ALPACA_SECRET_YALA=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Binance (crypto). Inscription : https://www.binance.com
# ATTENTION : limiter les permissions de la cle (lecture + spot trading),
# JAMAIS d'option "withdraw".
#ASSISTANT_BINANCE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#ASSISTANT_BINANCE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# --- Logging ---------------------------------------------------------------
# Mettre a 1 pour activer les logs DEBUG (verbeux). Sinon INFO par defaut.
#ASSISTANT_DEBUG=1
