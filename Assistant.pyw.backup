    def refresh_inbox(self):
        """Lance la récupération des mails dans un thread séparé."""
        self._inbox_mails = []
        self._inbox_active_filter = "TOUT"
        # Réinitialiser les boutons filtre
        for lbl, (btn, col) in self._filter_buttons.items():
            btn.configure(fg_color="#1a1a35" if lbl == "TOUT" else "transparent")

        for widget in self.inbox_scroll.winfo_children():
            widget.destroy()

        loader_frame = ctk.CTkFrame(self.inbox_scroll, fg_color="transparent")
        loader_frame.pack(fill="x", pady=30)
        ctk.CTkLabel(loader_frame, text="⬡", font=("Arial", 28), text_color=couleur_accent).pack()
        ctk.CTkLabel(loader_frame, text="Connexion au serveur neural...",
                     font=("Segoe UI", 12), text_color="#333").pack(pady=8)

        threading.Thread(target=self._fetch_emails_logic, daemon=True).start()

    def _apply_inbox_filter(self, filter_label):
        """Active un filtre et redessine les cartes."""
        self._inbox_active_filter = filter_label
        # Highlight du bouton actif
        for lbl, (btn, col) in self._filter_buttons.items():
            btn.configure(fg_color="#1a1a35" if lbl == filter_label else "transparent")
        self._render_inbox_cards()

    def _render_inbox_cards(self):
        """(Re)dessine les cartes selon le filtre actif, triées par urgence."""
        for w in self.inbox_scroll.winfo_children():
            w.destroy()

        urgency_order = {"haute": 0, "normale": 1, "faible": 2}
        filter_map = {"TOUT": None, "URGENT": "haute", "NORMAL": "normale", "INFO": "faible"}
        target = filter_map.get(self._inbox_active_filter)

        mails = self._inbox_mails
        # Tri : urgents d'abord, puis normaux, puis faibles
        mails_sorted = sorted(mails, key=lambda m: urgency_order.get(m.get("urgency", "normale"), 1))

        shown = 0
        for m in mails_sorted:
            if target is None or m.get("urgency") == target:
                self._add_mail_card(
                    m["sender"], m["subject"], m["summary"],
                    m["urgency"], m["action"], m["date_str"],
                    m.get("attach_summaries"), m.get("warning"),
                    m.get("mail_type", "inconnu"), m.get("agenda_suggestion")
                )
                shown += 1

        if shown == 0:
            ctk.CTkLabel(self.inbox_scroll,
                text="Aucun mail dans cette catégorie.",
                font=("Segoe UI", 11), text_color="#333").pack(pady=30)

    def _extract_attachment_text(self, part):
        """Extrait le texte d'une pièce jointe (PDF, DOCX, TXT, etc.)."""
        filename = part.get_filename() or ""
        if not filename:
            return None, None

        # Décodage du nom de fichier si encodé
        decoded = decode_header(filename)[0]
        if isinstance(decoded[0], bytes):
            filename = decoded[0].decode(decoded[1] or "utf-8", errors="ignore")

        ext = os.path.splitext(filename)[1].lower()
        payload = part.get_payload(decode=True)
        if not payload:
            return filename, None

        text = None

        # --- PDF ---
        if ext == ".pdf":
            try:
                import fitz
                import io
                with fitz.open(stream=payload, filetype="pdf") as doc:
                    text = ""
                    for page in doc:
                        text += page.get_text()
                text = text[:3000]  # Limiter pour l'IA
            except ImportError:
                text = "[PyMuPDF non installé - pip install pymupdf]"
            except Exception as e:
                text = f"[Erreur lecture PDF : {e}]"

        # --- DOCX ---
        elif ext == ".docx":
            try:
                import docx
                import io
                doc = docx.Document(io.BytesIO(payload))
                text = "\n".join([p.text for p in doc.paragraphs if p.text.strip()])
                text = text[:3000]
            except ImportError:
                text = "[python-docx non installé - pip install python-docx]"
            except Exception as e:
                text = f"[Erreur lecture DOCX : {e}]"

        # --- Texte brut / code ---
        elif ext in [".txt", ".md", ".csv", ".json", ".log", ".py", ".html", ".js"]:
            try:
                text = payload.decode("utf-8", errors="ignore")[:3000]
            except Exception:
                text = None

        return filename, text

    def _fetch_emails_logic(self):
        try:
            mail = imaplib.IMAP4_SSL("imap.gmail.com")
            mail.login(self.user_email, self.user_app_pass)
            mail.select("inbox")

            status, messages = mail.search(None, "ALL")
            mail_ids = messages[0].split()
            last_ids = mail_ids[-5:]  # 5 derniers mails

            fetched = []
            for m_id in reversed(last_ids):
                res, msg_data = mail.fetch(m_id, "(RFC822)")
                for response_part in msg_data:
                    if isinstance(response_part, tuple):
                        msg = email.message_from_bytes(response_part[1])

                        subject, encoding = decode_header(msg["Subject"])[0]
                        if isinstance(subject, bytes):
                            subject = subject.decode(encoding or "utf-8", errors="ignore")

                        sender = msg.get("From", "Inconnu")
                        date_str = msg.get("Date", "")

                        body = ""
                        attachments = []  # liste de (nom_fichier, texte_extrait)

                        if msg.is_multipart():
                            for part in msg.walk():
                                content_disposition = str(part.get("Content-Disposition", ""))
                                content_type = part.get_content_type()

                                # Corps du mail
                                if content_type == "text/plain" and "attachment" not in content_disposition:
                                    if not body:
                                        payload = part.get_payload(decode=True)
                                        if payload:
                                            body = payload.decode("utf-8", errors="ignore")

                                # Pièces jointes
                                elif "attachment" in content_disposition or part.get_filename():
                                    fname, ftext = self._extract_attachment_text(part)
                                    if fname:
                                        attachments.append((fname, ftext))
                        else:
                            payload = msg.get_payload(decode=True)
                            if payload:
                                body = payload.decode("utf-8", errors="ignore")

                        fetched.append((sender, subject, body, date_str, attachments))

            mail.close()
            mail.logout()

            if not fetched:
                self.root.after(0, lambda: self._show_inbox_empty())
                return

            # Effacer le loader
            self.root.after(0, lambda: [w.destroy() for w in self.inbox_scroll.winfo_children()])

            for sender, subject, body, date_str, attachments in fetched:
                summary, urgency, action, attach_summaries, warning, mail_type, agenda_sug = self._ai_summarize_mail(sender, subject, body, attachments)
                mail_data = {
                    "sender": sender, "subject": subject, "summary": summary,
                    "urgency": urgency, "action": action, "date_str": date_str,
                    "attach_summaries": attach_summaries, "warning": warning,
                    "mail_type": mail_type, "agenda_suggestion": agenda_sug
                }
                self._inbox_mails.append(mail_data)

            # Rendu trié après chargement complet
            self.root.after(0, self._render_inbox_cards)

        except Exception as e:
            self.root.after(0, lambda: self._show_inbox_error(str(e)))

    def _show_inbox_empty(self):
        for w in self.inbox_scroll.winfo_children():
            w.destroy()
        ctk.CTkLabel(self.inbox_scroll, text="Aucun mail trouvé.",
                     font=("Segoe UI", 12), text_color="#333").pack(pady=30)

    def _show_inbox_error(self, err):
        for w in self.inbox_scroll.winfo_children():
            w.destroy()
        ctk.CTkLabel(self.inbox_scroll, text=f"⚠ Erreur : {err[:80]}",
                     font=("Segoe UI", 11), text_color="#ff4444", wraplength=380).pack(pady=20)

    def _ai_summarize_mail(self, sender, subject, body, attachments=None):
        clean_body = body[:2500].replace('\n', ' ')
        attach_section = ""
        if attachments:
            for fname, ftext in attachments:
                if ftext:
                    attach_section += f"\n\nPIÈCE JOINTE '{fname}':\n{ftext[:2500]}"

        prompt = f"""Analyse ce mail reçu par {USERNAME} :

DE : {sender}
SUJET : {subject}
DATE DE RÉCEPTION : {datetime.now().strftime('%d/%m/%Y')}
CONTENU :
{clean_body}{attach_section}

Réponds UNIQUEMENT en JSON valide selon le format demandé. Aucun texte hors du JSON."""

        try:
            headers = {"Content-Type": "application/json", "Authorization": f"Bearer {API_KEY}"}
            payload = {
                "model": MODELE,
                "messages": [
                    {"role": "system", "content": INBOX_SYSTEM_PROMPT},
                    {"role": "user", "content": prompt}
                ],
                "temperature": 0.05
            }
            response = requests.post(URL, headers=headers, json=payload, timeout=30)
            raw = response.json()['choices'][0]['message']['content'].strip()
            raw = raw.replace("```json", "").replace("```", "").strip()

            data = json.loads(raw)
            actions = data.get("action", [])
            if isinstance(actions, str): actions = [actions]

            return (
                data.get("resume", ""),
                data.get("urgence", "normale"),
                actions,
                data.get("pieces_jointes", []),
                data.get("warning", None),
                data.get("type", "inconnu"),
                data.get("agenda_suggestion", None)
            )

        except Exception as e:
            return "Erreur analyse.", "faible", ["Lire le mail manuellement."], [], None, "inconnu", None

    def _add_mail_card(self, sender, subject, summary, urgency="normale", action="", date_str="", attach_summaries=None, warning=None, mail_type="inconnu", agenda_suggestion=None):
        urgency_colors = {
            "haute":   "#ff4060",
            "normale": "#22b9ff",
            "faible":  "#5a5a8a",
        }
        type_icons = {
            "cv": "📄", "facture": "💳", "relance": "📣", "phishing": "☠",
            "arnaque": "☠", "spam": "🗑", "newsletter": "📰", "invitation": "🎟",
            "contractuel": "📋", "juridique": "⚖", "support": "🛠",
            "professionnel": "💼", "personnel": "💬", "inconnu": "❓"
        }
        urg_color = urgency_colors.get(urgency, "#22b9ff")
        type_icon = type_icons.get(mail_type, "✉")

        # Bordure colorée selon contexte
        card_border = "#ff2244" if warning else ("#2a2a45" if urgency != "haute" else "#4a2030")

        # === CARD CONTAINER ===
        card = ctk.CTkFrame(self.inbox_scroll, fg_color="#0c0c1c",
                            corner_radius=18, border_width=1,
                            border_color=card_border)
        card.pack(padx=10, pady=7, fill="x")

        # Barre latérale colorée selon urgence / warning
        bar_color = "#ff2244" if warning else urg_color
        accent_bar = tk.Frame(card, bg=bar_color, width=4)
        accent_bar.pack(side="left", fill="y", padx=(0, 0))

        content = ctk.CTkFrame(card, fg_color="transparent")
        content.pack(side="left", fill="both", expand=True, padx=14, pady=12)

        # === LIGNE HAUTE : TYPE BADGE + SENDER + DATE ===
        top_row = ctk.CTkFrame(content, fg_color="transparent")
        top_row.pack(fill="x")

        # Badge type
        type_badge = ctk.CTkLabel(top_row,
            text=f"{type_icon} {mail_type.upper()}",
            font=("Futura", 7, "bold"),
            text_color=urg_color,
            fg_color="#0f0f22",
            corner_radius=6,
            padx=6, pady=2)
        type_badge.pack(side="left")

        sender_clean = re.sub(r'<.*?>', '', sender).strip()[:32]
        ctk.CTkLabel(top_row,
            text=f"  {sender_clean}",
            font=("Segoe UI", 9), text_color="#3a3a5c").pack(side="left")

        # Date formatée
        if date_str:
            try:
                from email.utils import parsedate_to_datetime
                dt = parsedate_to_datetime(date_str)
                date_nice = dt.strftime("%d/%m %H:%M")
            except:
                date_nice = date_str[:10]
            ctk.CTkLabel(top_row,
                text=date_nice,
                font=("Consolas", 8), text_color="#2a2a44").pack(side="right")

        if attach_summaries:
            ctk.CTkLabel(top_row,
                text=f"  📎{len(attach_summaries)}",
                font=("Segoe UI", 9, "bold"), text_color="#ffb366").pack(side="right")

        # === WARNING BLOCK (arnaque/phishing) ===
        if warning:
            warn_frame = ctk.CTkFrame(content, fg_color="#1a0010", corner_radius=8, border_width=1, border_color="#ff2244")
            warn_frame.pack(fill="x", pady=(8, 0))
            ctk.CTkLabel(warn_frame,
                text=f"⚠  {warning}",
                font=("Futura", 9, "bold"),
                text_color="#ff4060",
                wraplength=370, justify="left").pack(padx=12, pady=8, anchor="w")

        # === SUJET ===
        tk.Frame(content, bg="#1c1c35", height=1).pack(fill="x", pady=(8, 5))
        ctk.CTkLabel(content,
            text=subject[:65],
            font=("Futura", 11, "bold"),
            text_color="#dde4ff", anchor="w").pack(fill="x")

        # === RÉSUMÉ ===
        ctk.CTkLabel(content,
            text=summary,
            font=("Segoe UI", 10),
            text_color="#7a7aaa",
            wraplength=360, anchor="w", justify="left").pack(fill="x", pady=(3, 0))

        # === PIÈCES JOINTES ===
        if attach_summaries:
            tk.Frame(content, bg="#1c1c35", height=1).pack(fill="x", pady=(8, 4))
            for att in attach_summaries:
                att_row = ctk.CTkFrame(content, fg_color="#0d0d25", corner_radius=8)
                att_row.pack(fill="x", pady=2)
                ctk.CTkLabel(att_row,
                    text=f"📎 {att.get('nom', 'Fichier')[:42]}",
                    font=("Consolas", 9, "bold"), text_color="#ffb366").pack(anchor="w", padx=10, pady=2)
                if att.get("resume"):
                    ctk.CTkLabel(att_row,
                        text=att["resume"],
                        font=("Segoe UI", 9), text_color="#555577",
                        wraplength=340, justify="left").pack(anchor="w", padx=10, pady=(0, 5))

        # === CONSEILS ===
        if action:
            action_frame = ctk.CTkFrame(content, fg_color="#0d0d20", corner_radius=10)
            action_frame.pack(fill="x", pady=(10, 0))

            if isinstance(action, list):
                points = []
                for pt in action:
                    clean = str(pt).strip().replace("→","").replace("->","").replace("*","").rstrip(".,")
                    if clean: points.append(f"› {clean}")
                formatted = "\n".join(points)
            else:
                formatted = f"› {str(action).replace('→','').replace('->','')}"

            ctk.CTkLabel(action_frame,
                text=formatted,
                font=("Segoe UI", 9, "bold"),
                text_color="#22b9ff",
                anchor="w", justify="left", wraplength=355).pack(padx=14, pady=10, fill="x")

        # === BOUTON AGENDA (si suggestion) ===
        if agenda_suggestion and not warning:
            def add_from_inbox(sug=agenda_suggestion):
                title = sug.get("title", "Événement mail")
                note = sug.get("note", "")
                hint = sug.get("date_hint", "")
                # Tenter de parser une date dans date_hint, sinon demain
                import re as _re
                date_target = (datetime.now() + timedelta(days=1)).strftime("%Y-%m-%d")
                try:
                    found = _re.search(r"(\d{4}-\d{2}-\d{2})", hint)
                    if found: date_target = found.group(1)
                except: pass
                self.add_agenda_event(title, date_target, "", f"Ajouté depuis inbox. {note} Indice date: {hint}")
                self.root.after(0, lambda: self._show_toast(f"📅 Ajouté : {title[:30]}"))

            btn_row = ctk.CTkFrame(content, fg_color="transparent")
            btn_row.pack(fill="x", pady=(8, 0))
            ctk.CTkButton(btn_row,
                text=f"📅  Ajouter à l'agenda — {agenda_suggestion.get('title', '')[:30]}",
                font=("Futura", 9, "bold"),
                height=30, corner_radius=15,
                fg_color="#1a0f35", hover_color="#2d1f60",
                text_color=couleur_agenda, border_width=1, border_color=couleur_agenda,
                command=add_from_inbox).pack(side="left")

        # Boutons Archive / Supprimer (en bas de chaque carte)
        action_row = ctk.CTkFrame(content, fg_color="transparent")
        action_row.pack(fill="x", pady=(6, 0))
        ctk.CTkButton(action_row, text="🗄 Archiver", width=90, height=26,
                      fg_color="transparent", hover_color="#0a2a1a",
                      text_color="#224422", corner_radius=13, font=("Futura", 8),
                      command=lambda: (card.destroy(),
                          database.add_experience_entry(USERNAME, "mail_classified",
                          f"Archivé: {subject}", "success", 1.0))).pack(side="right", padx=(4, 0))
        ctk.CTkButton(action_row, text="🗑 Supprimer", width=95, height=26,
                      fg_color="transparent", hover_color="#2a0a0a",
                      text_color="#553333", corner_radius=13, font=("Futura", 8),
                      command=lambda: (card.destroy(),
                          database.add_experience_entry(USERNAME, "mail_classified",
                          f"Supprimé: {subject}", "success", 1.0))).pack(side="right")

    # ==========================================
    #        NAVIGATION
    # ==========================================
    def _hide_all_frames(self):
        for w in [self.chat_frame, self.mail_frame, self.options_frame,
                  self.admin_frame, self.bubble_canvas, self.hub_canvas,
                  self.inbox_frame, self.agenda_frame,
                  getattr(self, 'reseau_frame', None),
                  getattr(self, 'permissions_frame', None)]:
            if w is None: continue
            try:
                w.pack_forget()
            except Exception:
                pass

    def toggle_chat(self):
        if self.mode == "chat":
            self.root.withdraw(); self.mode = "hidden"
        else:
            self._hide_all_frames()
            self.hub_open = False
            self.chat_frame.pack(fill="both", expand=True)
            self.root.geometry("450x650")
            self.root.deiconify()
            self.mode = "chat"
            self.entry.focus_set()

    def toggle_bubble(self):
        if self.mode == "bubble":
            self.root.withdraw(); self.mode = "hidden"
        else:
            self._hide_all_frames()
            self.hub_open = False
            self.bubble_canvas.pack()
            self.root.geometry(f"{self.bubble_win_size}x{self.bubble_win_size}")
            self.root.deiconify()
            self.mode = "bubble"

    def toggle_inbox(self):
        if self.mode == "inbox":
            self.root.withdraw(); self.mode = "hidden"
        else:
            self._hide_all_frames()
            # On ajoute un petit padding (padx/pady) pour que les arrondis soient parfaits
            self.inbox_frame.pack(fill="both", expand=True, padx=2, pady=2)
            
            w, h = 470, 620
            x = (self.sw // 2) - (w // 2)
            y = (self.sh // 2) - (h // 2)
            self.root.geometry(f"{w}x{h}+{int(x)}+{int(y)}")
            self.root.deiconify()
            self.mode = "inbox"
            self.refresh_inbox()

    def toggle_agenda(self):
        if self.mode == "agenda":
            self.root.withdraw(); self.mode = "hidden"
        else:
            self._hide_all_frames()
            self.agenda_frame.pack(fill="both", expand=True)
            w, h = 430, 620
            x = (self.sw // 2) - (w // 2)
            y = (self.sh // 2) - (h // 2)
            self.root.geometry(f"{w}x{h}+{int(x)}+{int(y)}")
            self.root.deiconify()
            self.mode = "agenda"
            self._agenda_selected_date = date.today()
            self._render_agenda_calendar()
            self._agenda_select_day(date.today())

    def toggle_hub(self):
        if self.mode == "hub":
            self.hub_open = False
            self.root.withdraw(); self.mode = "hidden"
        else:
            self._hide_all_frames()
            self.hub_open = False
            self.hub_dots_progress = [0.0] * 9
            self.hub_canvas.pack(fill="both", expand=True)
            self.root.geometry(f"{self.hub_size}x{self.hub_size}")
            self.root.deiconify()
            self.root.attributes("-topmost", True)
            self.mode = "hub"
            self._refresh_pending_cache()
            self.root.after(50, self._hub_logo_loop)

    def toggle_options(self):
        if self.mode == "options":
            self.root.withdraw(); self.mode = "hidden"
        else:
            self._hide_all_frames()
            self.hub_open = False
            self.options_frame.pack(fill="both", expand=True)
            self.root.geometry("380x600")
            self.root.deiconify()
            self.mode = "options"

    def toggle_admin(self):
        if USER_LEVEL > 0:
            return
        if self.mode == "admin":
            self.root.withdraw(); self.mode = "hidden"
        else:
            self._hide_all_frames()
            self.hub_open = False
            self.admin_frame.pack(fill="both", expand=True)
            self.root.geometry("540x660")
            self.root.deiconify()
            self.mode = "admin"
            self.refresh_admin_logs(self.admin_user_list.get())

    def toggle_mail(self):
        if self.mode == "mail":
            self.root.withdraw(); self.mode = "hidden"
        else:
            self._hide_all_frames()
            self.hub_open = False
            self.mail_status.configure(text="", text_color="#00ffcc")
            self.mail_attachment_path = None
            self.lbl_file_status.configure(text="Aucun fichier", text_color="#555")
            self.root.geometry("400x650")
            self.mail_frame.pack(fill="both", expand=True)
            self.root.deiconify()
            self.mode = "mail"

    def auto_return_hub(self):
        if self.mode == "mail":
            self.toggle_hub()

    def logout(self):
        database.set_user_online(USERNAME, False)
        subprocess.Popen([sys.executable, "Login.pyw"])
        self.root.quit()
        sys.exit()

    # ==========================================
    #        CHAT & IA
    # ==========================================
    def send_logic(self):
        text = self.entry.get().strip()
        if not text:
            return

        # Commandes navigation
        if text.lower() in ["/agenda", "agenda", "ouvre agenda", "ouvrir agenda"]:
            self.entry.delete(0, "end")
            self.toggle_agenda()
            return
        if text.lower() in ["/permissions", "permissions", "/perms", "perms"]:
            self.entry.delete(0, "end")
            self.toggle_permissions()
            return

        full_content = text
        if self.chat_attachment_path:
            full_content += f" [FILE_ATTACHED: {os.path.basename(self.chat_attachment_path)}]"

        self.add_message("USER", text)
        self.entry.delete(0, "end")
        self.history.append({"role": "user", "content": full_content})

        if re.search(r"[\w\.-]+@[\w\.-]+\.\w+", text):
            self._switch_to_mail_mode_from_chat()

        threading.Thread(target=self.requete_directe, daemon=True).start()

    def _switch_to_mail_mode_from_chat(self):
        pass

    def requete_directe(self):
        try:
            headers = {
                "Content-Type": "application/json",
                "Authorization": f"Bearer {API_KEY}"
            }

            last_msg_text = self.history[-1]["content"] if self.history else ""
            file_text_content = ""
            image_b64 = None

            if self.chat_attachment_path and os.path.exists(self.chat_attachment_path):
                ext = os.path.splitext(self.chat_attachment_path)[1].lower()
                if ext in ['.png', '.jpg', '.jpeg', '.webp']:
                    try:
                        with open(self.chat_attachment_path, "rb") as f:
                            image_b64 = base64.b64encode(f.read()).decode('utf-8')
                    except Exception as e:
                        print(f"Erreur image: {e}")
                file_text_content = self._get_attachment_data(self.chat_attachment_path)

            full_user_prompt = f"{last_msg_text}{file_text_content}"

            today_str = datetime.now().strftime("%A %d %B %Y")
            system_with_date = SYSTEM_INSTRUCTION.replace("{TODAY}", today_str)
            messages = [{"role": "system", "content": system_with_date}]
            for h in self.history[:-1]:
                messages.append(h)

            user_content = [{"type": "text", "text": full_user_prompt}]
            if image_b64:
                user_content.append({
                    "type": "image_url",
                    "image_url": {"url": f"data:image/jpeg;base64,{image_b64}"}
                })

            messages.append({"role": "user", "content": user_content})

            payload = {
                "model": MODELE,
                "messages": messages,
                "temperature": AI_TEMPERATURE,
                "max_tokens": 1500
            }

            response = self.session.post(URL, headers=headers, json=payload, timeout=(5, 60))

            if response.status_code == 200:
                raw = response.json()['choices'][0]['message']['content']

                # === ORDRE CRITIQUE : parser les commandes sur la réponse BRUTE ===
                self._process_agenda_command(raw)
                self._process_scheduled_mail(raw)
                if self.lacher_prise_mode:
                    # Mode Lâcher Prise : exécution directe sans permission
                    mail_detected = self.process_ai_commands(raw)
                else:
                    # Mode normal : créer une requête de permission
                    if "COMMAND_START" in raw and "COMMAND_END" in raw:
                        self._create_mail_permission_request(raw)
                        mail_detected = False
                    else:
                        mail_detected = self.process_ai_commands(raw)

                # Nettoyage pour l'affichage et la mémoire
                txt = self.clean_text(raw)

                self.history.append({"role": "assistant", "content": txt})
                self.save_memory()
                database.add_experience_entry(USERNAME, "chat_response",
                                              f"Q: {self.history[-2].get('content','')[:60] if len(self.history)>=2 else ''}",
                                              "success", 1.0)

                self.root.after(0, lambda: self.add_message("MISTRAL", txt))
                self.root.after(0, self.start_notification_blink)

                self.chat_attachment_path = None
            else:
                self.root.after(0, lambda: self.add_message("SYSTEM", f"⚠️ Erreur API {response.status_code}"))

        except Exception as e:
            print(f"Erreur critique : {e}")
            self.root.after(0, lambda: self.add_message("SYSTEM", "⚠️ Impossible de lire le fichier ou l'IA est indisponible."))

    def _process_agenda_command(self, text):
        """Détecte et exécute une commande d'ajout d'événement agenda."""
        if "AGENDA_ADD_START" not in text or "AGENDA_ADD_END" not in text:
            return

        try:
            # On isole d'abord le bloc pour éviter d'attraper TITLE: d'un autre contexte
            block_m = re.search(r"AGENDA_ADD_START(.*?)AGENDA_ADD_END", text, re.DOTALL)
            block = block_m.group(1) if block_m else text

            title_m = re.search(r"TITLE\s*:\s*(.+)", block)
            date_m  = re.search(r"DATE\s*:\s*(\d{4}-\d{2}-\d{2})", block)
            time_m  = re.search(r"TIME\s*:\s*(\d{1,2}[:hH]\d{2})", block)
            note_m  = re.search(r"NOTE\s*:\s*(.+)", block)

            def _clean(s):
                # Enlève guillemets, backticks, espaces en trop
                return s.strip().strip('"').strip("'").strip("`").strip()

            title = _clean(title_m.group(1)) if title_m else "Événement"
            date_str = date_m.group(1).strip() if date_m else date.today().strftime("%Y-%m-%d")

            # Normalisation de l'heure : accepte "14h30" aussi bien que "14:30"
            time_raw = time_m.group(1).strip() if time_m else ""
            time_str = ""
            if time_raw:
                time_norm = time_raw.replace("h", ":").replace("H", ":")
                # Forcer 2 chiffres pour l'heure
                parts = time_norm.split(":")
                if len(parts) == 2:
                    time_str = f"{int(parts[0]):02d}:{parts[1][:2]}"

            note = _clean(note_m.group(1)) if note_m else ""

            self.add_agenda_event(title, date_str, time_str, note)
            self.root.after(0, lambda: self.add_message(
                "SYSTEM", f"📅 Événement ajouté : {title} — {date_str} {time_str}".rstrip()))
        except Exception as e:
            print(f"Erreur agenda command : {e}")

    def _create_mail_permission_request(self, raw_text):
        """En mode normal, crée une requête de permission pour l'envoi de mail."""
        try:
            block_m = re.search(r"COMMAND_START(.*?)COMMAND_END", raw_text, re.DOTALL)
            block = block_m.group(1) if block_m else raw_text
            to_m   = re.search(r"TO\s*:\s*([\w\.\-]+@[\w\.\-]+\.\w+)", block)
            sub_m  = re.search(r"SUBJECT\s*:\s*(.+)", block)
            body_m = re.search(r"BODY\s*:(.*?)$", block, re.DOTALL)
            dest  = to_m.group(1).strip() if to_m else None
            sujet = sub_m.group(1).strip() if sub_m else "Message"
            corps = body_m.group(1).strip() if body_m else ""
            if dest:
                database.add_permission_request(
                    USERNAME, "mail_send",
                    f"Envoyer mail à {dest}",
                    f"Sujet : {sujet}",
                    {"to": dest, "subject": sujet, "body": corps}
                )
                self.root.after(0, lambda: self.add_message("SYSTEM",
                    f"📨 Mail en attente → {dest}. Ouvrez Permissions (⚡) pour valider."))
        except Exception as e:
            print(f"Erreur permission request : {e}")
            self.process_ai_commands(raw_text)

    def process_ai_commands(self, text):
        if "COMMAND_START" not in text or "COMMAND_END" not in text:
            return False

        try:
            block_m = re.search(r"COMMAND_START(.*?)COMMAND_END", text, re.DOTALL)
            block = block_m.group(1) if block_m else text

            to_match   = re.search(r"TO\s*:\s*([\w\.-]+@[\w\.-]+\.\w+)", block)
            sub_match  = re.search(r"SUBJECT\s*:\s*(.+)", block)
            body_match = re.search(r"BODY\s*:(.*?)$", block, re.DOTALL)

            dest  = to_match.group(1).strip()   if to_match   else None
            sujet = sub_match.group(1).strip().strip('"').strip("'") if sub_match else "Message de l'Assistant"
            corps = body_match.group(1).strip() if body_match else None

            if dest and corps:
                self.root.after(0, lambda: self.add_message("SYSTEM", f"🚀 Envoi automatique du mail à {dest}..."))
                threading.Thread(target=self.execute_auto_mail,
                             args=(dest, sujet, corps, self.chat_attachment_path),
                             daemon=True).start()
                self.chat_attachment_path = None
                return True
            return False
        except Exception as e:
            print(f"Erreur d'analyse commande IA : {e}")
            return False

    def _prefill_mail_form(self, dest, sujet, corps):
        self.mail_to.delete(0, "end")
        self.mail_to.insert(0, dest)
        self.mail_subject.delete(0, "end")
        self.mail_subject.insert(0, sujet)
        self.mail_body.delete("1.0", "end")
        self.mail_body.insert("1.0", corps)

    def execute_auto_mail(self, dest, sujet, corps, attachment_path=None):
        if not self.user_email or not self.user_app_pass:
            self.root.after(0, lambda: self.add_message("SYSTEM", "❌ Erreur : Gmail non configuré dans la base."))
            return

        try:
            msg = MIMEMultipart()
            msg['From']    = self.user_email
            msg['To']      = dest
            msg['Subject'] = sujet
            msg.attach(MIMEText(corps, 'plain'))

            if attachment_path and os.path.exists(attachment_path):
                filename = os.path.basename(attachment_path)
                ctype, _ = mimetypes.guess_type(attachment_path)
                main, sub = (ctype or "application/octet-stream").split('/', 1)
                with open(attachment_path, "rb") as f:
                    part = MIMEBase(main, sub)
                    part.set_payload(f.read())
                encoders.encode_base64(part)
                part.add_header('Content-Disposition', 'attachment', filename=filename)
                msg.attach(part)

            server = smtplib.SMTP('smtp.gmail.com', 587)
            server.starttls()
            server.login(self.user_email, self.user_app_pass)
            server.send_message(msg)
            server.quit()

            database.add_experience_entry(USERNAME, "mail_sent", f"Auto-envoi à {dest} : {sujet}", "success", 1.0)
            self.root.after(0, lambda: self.add_message("SYSTEM", f"✅ Mail envoyé avec succès à {dest} !"))

        except Exception as e:
            err = str(e)[:60]
            self.root.after(0, lambda m=err: self.add_message("SYSTEM", f"❌ Échec de l'envoi : {m}"))

    # ==========================================
    #        FORMULAIRE MAIL MANUEL
    # ==========================================
    def attach_file_logic(self):
        path = filedialog.askopenfilename()
        if path:
            self.mail_attachment_path = path
            self.lbl_file_status.configure(text=f"Joint : {os.path.basename(path)}", text_color="#44ff88")

    def chat_attach_file(self):
        path = filedialog.askopenfilename()
        if path:
            self.chat_attachment_path = path
            self.add_message("SYSTEM", f"📎 Fichier prêt : {os.path.basename(path)}")

    def send_mail_logic(self):
        dest  = self.mail_to.get().strip()
        sujet = self.mail_subject.get().strip()
        corps = self.mail_body.get("1.0", "end").strip()

        if not dest:
            self.mail_status.configure(text="DESTINATAIRE MANQUANT", text_color="#ff4444")
            return
        if not self.user_email or not self.user_app_pass:
            self.mail_status.configure(text="EMAIL NON CONFIGURÉ", text_color="#ff4444")
            return

        def thread_mail():
            try:
                self.root.after(0, lambda: self.mail_status.configure(text="ENVOI EN COURS...", text_color="#00ffcc"))

                msg = MIMEMultipart()
                msg['From']    = self.user_email
                msg['To']      = dest
                msg['Subject'] = sujet
                msg.attach(MIMEText(corps, 'plain'))

                if self.mail_attachment_path and os.path.exists(self.mail_attachment_path):
                    filename = os.path.basename(self.mail_attachment_path)
                    ctype, _ = mimetypes.guess_type(self.mail_attachment_path)
                    main, sub = (ctype or "application/octet-stream").split('/', 1)
                    with open(self.mail_attachment_path, "rb") as f:
                        part = MIMEBase(main, sub)
                        part.set_payload(f.read())
                    encoders.encode_base64(part)
                    part.add_header('Content-Disposition', 'attachment', filename=filename)
                    msg.attach(part)

                server = smtplib.SMTP('smtp.gmail.com', 587)
                server.starttls()
                server.login(self.user_email, self.user_app_pass)
                server.send_message(msg)
                server.quit()

                self.root.after(0, self.on_mail_success)

            except Exception as e:
                err = str(e)[:40]
                self.root.after(0, lambda m=err: self.mail_status.configure(text=f"ERREUR : {m}", text_color="#ff4444"))

        threading.Thread(target=thread_mail, daemon=True).start()

    def on_mail_success(self):
        self.mail_status.configure(text="MESSAGE ENVOYÉ ✔", text_color="#44ff88")
        self.mail_to.delete(0, "end")
        self.mail_subject.delete(0, "end")
        self.mail_body.delete("1.0", "end")
        self.mail_attachment_path = None
        self.lbl_file_status.configure(text="Aucun fichier", text_color="#555")
        self.root.after(2000, self.auto_return_hub)

    # ==========================================
    #        MÉMOIRE & MESSAGES
    # ==========================================
    def clean_text(self, text):
        text = re.sub(r"AGENDA_ADD_START.*?AGENDA_ADD_END", "", text, flags=re.DOTALL)
        text = re.sub(r"SCHEDULED_MAIL_START.*?SCHEDULED_MAIL_END", "", text, flags=re.DOTALL)
        text = re.sub(r"COMMAND_START.*?COMMAND_END", "", text, flags=re.DOTALL)
        return text.replace("*", "").strip()

    def add_message(self, sender, text):
        display_text = re.sub(r"COMMAND_START.*?COMMAND_END", "", text, flags=re.DOTALL).strip()
        display_text = re.sub(r"AGENDA_ADD_START.*?AGENDA_ADD_END", "", display_text, flags=re.DOTALL).strip()
        display_text = re.sub(r"SCHEDULED_MAIL_START.*?SCHEDULED_MAIL_END", "", display_text, flags=re.DOTALL).strip()
        if not display_text and sender == "MISTRAL":
            return None

        # Configuration visuelle par type d'expéditeur
        if sender == "USER":
            side     = "e"
            bg       = "#0b5fd4"       # bleu plus profond
            border   = "#2d7dff"       # halo bleu
            fg       = "#ffffff"
            max_w    = 290
        elif sender == "MISTRAL":
            side     = "w"
            bg       = "#141425"
            border   = "#22b9ff"       # accent néon
            fg       = "#dde4ff"
            max_w    = 300
        else:  # SYSTEM
            side     = "w"
            bg       = "#1a1025"
            border   = "#c084fc"       # accent violet
            fg       = "#c9b8e6"
            max_w    = 290

        msg_box = ctk.CTkFrame(
            self.msg_area,
            fg_color=bg,
            corner_radius=16,
            border_width=1,
            border_color=border,
        )
        msg_box.pack(padx=14, pady=6, anchor=side)

        lbl = ctk.CTkLabel(
            msg_box, text=display_text,
            wraplength=max_w, justify="left",
            font=("Segoe UI", 11),
            text_color=fg,
        )
        lbl.pack(padx=14, pady=10)

        try:
            self.msg_area._parent_canvas.yview_moveto(1.0)
        except Exception:
            pass
        return msg_box

    def smart_reset(self):
        self.history = []
        self.save_memory()
        for widget in self.msg_area.winfo_children():
            widget.destroy()
        self.add_message("SYSTEM", f"Mémoire effacée pour {USERNAME}.")

    def load_memory(self):
        if os.path.exists(MEMORY_FILE):
            try:
                with open(MEMORY_FILE, "r", encoding="utf-8") as f:
                    return json.load(f)
            except Exception:
                return []
        return []

    def save_memory(self):
        try:
            with open(MEMORY_FILE, "w", encoding="utf-8") as f:
                json.dump(self.history[-30:], f, indent=4, ensure_ascii=False)
        except Exception as e:
            print(f"Erreur sauvegarde mémoire : {e}")

    def start_notification_blink(self):
        self.blink_end_time = time.time() + 3.0

    # ==========================================
    #        ADMIN
    # ==========================================
    def refresh_admin_logs(self, selected_user):
        self.admin_log_area.delete("1.0", "end")
        self.admin_log_area.insert("end", f"══ HUB DE {selected_user.upper()} ══\n\n")
        # Mémoire chat
        target_file = f"memory_{selected_user}.json"
        if os.path.exists(target_file):
            try:
                with open(target_file, "r", encoding="utf-8") as f:
                    data = json.load(f)
                self.admin_log_area.insert("end", "── HISTORIQUE CHAT ──\n")
                for msg in data[-10:]:
                    role = msg.get('role', '???').upper()
                    txt  = msg.get('content', '')[:120]
                    self.admin_log_area.insert("end", f"[{role}] : {txt}\n\n")
            except Exception:
                self.admin_log_area.insert("end", "Erreur lecture mémoire.\n")
        else:
            self.admin_log_area.insert("end", f"Pas d'historique pour {selected_user}.\n")
        # Agenda
        agenda_file = f"agenda_{selected_user}.json"
        if os.path.exists(agenda_file):
            try:
                with open(agenda_file, "r", encoding="utf-8") as f:
                    agenda_data = json.load(f)
                self.admin_log_area.insert("end", f"\n── AGENDA ({selected_user}) ──\n")
                today_str = date.today().strftime("%Y-%m-%d")
                upcoming = [ev for ev in agenda_data if ev.get("date","") >= today_str]
                for ev in sorted(upcoming, key=lambda e: e.get("date",""))[:10]:
                    self.admin_log_area.insert("end",
                        f"📅 {ev.get('date','')} {ev.get('time','')} — {ev.get('title','?')}\n")
                if not upcoming:
                    self.admin_log_area.insert("end", "Aucun événement à venir.\n")
            except:
                pass
        # Expérience log
        log = database.load_experience_log()
        user_log = [e for e in log if e.get("username") == selected_user][-10:]
        if user_log:
            self.admin_log_area.insert("end", f"\n── ACTIONS RÉCENTES ──\n")
            for e in user_log:
                self.admin_log_area.insert("end",
                    f"[{e.get('action_type','?')}] {e.get('details',''[:60])}\n")


    # ==========================================
    #        RÉSEAU NEURAL
    # ==========================================
    def _network_refresh_loop(self):
        while True:
            try:
                self._network_users = database.get_all_users_info()
                if self.mode == "reseau":
                    self.root.after(0, self._render_reseau)
            except:
                pass
            time.sleep(10)

    def _build_reseau_frame(self):
        self.reseau_frame = ctk.CTkFrame(self.root, fg_color="#080808",
                                          border_color=couleur_reseau, border_width=2, corner_radius=30)
        hdr = ctk.CTkFrame(self.reseau_frame, fg_color="transparent")
        hdr.pack(fill="x", padx=20, pady=(18, 8))
        ctk.CTkLabel(hdr, text="⬡  RÉSEAU NEURAL",
                     font=("Futura", 16, "bold"), text_color=couleur_reseau).pack(side="left")
        ctk.CTkButton(hdr, text="← HUB", width=60, height=28,
                      fg_color="transparent", hover_color="#1a1400",
                      text_color=couleur_reseau, font=("Futura", 9),
                      command=self.toggle_hub).pack(side="right")
        tk.Frame(self.reseau_frame, bg="#1a1400", height=1).pack(fill="x", padx=20, pady=(0, 8))

        # Canvas réseau interactif
        self.reseau_canvas = tk.Canvas(self.reseau_frame, width=440, height=260,
                                       bg="#050508", highlightthickness=0)
        self.reseau_canvas.pack(padx=16, pady=8)

        # Config réseau
        cfg = ctk.CTkScrollableFrame(self.reseau_frame, fg_color="#0a0a00",
                                      corner_radius=12, height=200)
        cfg.pack(fill="x", padx=16, pady=8)
        ctk.CTkLabel(cfg, text="Configuration globale du réseau",
                     font=("Futura", 11, "bold"), text_color=couleur_reseau).pack(anchor="w", padx=12, pady=(8, 4))

        row2 = ctk.CTkFrame(cfg, fg_color="transparent")
        row2.pack(fill="x", padx=12, pady=4)
        ctk.CTkButton(row2, text="Envoyer rapport maintenant", height=32, corner_radius=16,
                      fg_color="#1a1400", hover_color=couleur_reseau, text_color=couleur_reseau,
                      font=("Futura", 10),
                      command=lambda: threading.Thread(target=self._send_daily_report, daemon=True).start()
                      ).pack(side="left")

        ctk.CTkLabel(cfg, text="Utilisateurs du réseau :",
                     font=("Futura", 10, "bold"), text_color="#887700").pack(anchor="w", padx=12, pady=(10, 4))
        users_info = database.get_all_users_info()
        for uname, info in users_info.items():
            lvl = info["permissions"][0] if info["permissions"] else 1
            online = info.get("is_online", False)
            role = info.get("role", "")
            dot_col = "#44ff88" if online else "#333322"
            row = ctk.CTkFrame(cfg, fg_color="transparent")
            row.pack(fill="x", padx=12, pady=2)
            ctk.CTkLabel(row, text="●" if online else "○", font=("Arial", 11),
                         text_color=dot_col, width=14).pack(side="left")
            lbl = f"{uname}  [{role}]  (Niv.{lvl})" if role else f"{uname}  (Niv.{lvl})"
            ctk.CTkLabel(row, text=lbl, font=("Segoe UI", 10), text_color="#888833").pack(side="left", padx=6)

        self.reseau_frame.bind("<Button-1>", self.click_window)

    def _render_reseau(self):
        if not hasattr(self, "reseau_canvas"):
            return
        c = self.reseau_canvas
        c.delete("all")
        users_info = database.get_all_users_info()
        cx, cy = 220, 130
        radius = 90
        nb = max(len(users_info), 1)
        pulse = (math.sin(time.time() * 2) + 1) / 2

        for i, (uname, info) in enumerate(users_info.items()):
            angle = math.radians(i * (360 / nb) - 90)
            ux = cx + radius * math.cos(angle)
            uy = cy + radius * math.sin(angle)
            is_me = (uname == USERNAME)
            is_online = info.get("is_online", False)
            lvl = info["permissions"][0] if info["permissions"] else 1
            lvl_colors = {0: couleur_gold, 1: couleur_accent, 2: couleur_permissions}
            col = lvl_colors.get(lvl, couleur_accent) if is_online else "#333333"

            c.create_line(cx, cy, ux, uy, fill="#1a1a00" if not is_online else "#332200", width=1)
            if is_online:
                halo = 20 + pulse * 7
                c.create_oval(ux-halo, uy-halo, ux+halo, uy+halo, outline=col, width=1)
            r = 16 if is_me else 12
            c.create_oval(ux-r, uy-r, ux+r, uy+r, fill="#0a0a00", outline=col, width=2 if is_me else 1)
            c.create_text(ux, uy+r+10, text=uname[:8], fill=col, font=("Futura", 7, "bold"))
            role = info.get("role", "")
            if role:
                c.create_text(ux, uy+r+20, text=role[:8], fill="#554400", font=("Arial", 6))

        # Centre = session actuelle
        ps = 28 + pulse * 9
        c.create_oval(cx-ps, cy-ps, cx+ps, cy+ps, outline=couleur_reseau, width=1)
        c.create_oval(cx-24, cy-24, cx+24, cy+24, fill="#0d0d00", outline=couleur_reseau, width=2)
        c.create_text(cx, cy-4, text=USERNAME[:8], fill=couleur_reseau, font=("Futura", 8, "bold"))
        c.create_text(cx, cy+8, text="SESSION", fill="#665500", font=("Arial", 6))

    # ==========================================
    #        MODULE PERMISSIONS CENTRALISÉ
    # ==========================================
    def _build_permissions_frame(self):
        self.permissions_frame = ctk.CTkFrame(self.root, fg_color="#080810",
                                               border_color=couleur_permissions, border_width=2, corner_radius=30)
        hdr = ctk.CTkFrame(self.permissions_frame, fg_color="transparent")
        hdr.pack(fill="x", padx=20, pady=(18, 8))
        ctk.CTkLabel(hdr, text="⚡  PERMISSIONS",
                     font=("Futura", 16, "bold"), text_color=couleur_permissions).pack(side="left")
        ctk.CTkButton(hdr, text="← HUB", width=60, height=28,
                      fg_color="transparent", hover_color="#1a0000",
                      text_color=couleur_permissions, font=("Futura", 9),
                      command=self.toggle_hub).pack(side="right")
        tk.Frame(self.permissions_frame, bg="#1a0000", height=1).pack(fill="x", padx=20, pady=(0, 8))

        # Bouton Magique — Tout Accepter
        ctk.CTkButton(self.permissions_frame, text="⚡  TOUT ACCEPTER",
                      fg_color="#330015", hover_color=couleur_permissions,
                      text_color=couleur_permissions,
                      width=380, height=48, corner_radius=24,
                      font=("Futura", 14, "bold"),
                      command=self._accept_all_permissions).pack(padx=20, pady=8)
        tk.Frame(self.permissions_frame, bg="#1a0000", height=1).pack(fill="x", padx=20, pady=4)

        self.permissions_scroll = ctk.CTkScrollableFrame(
            self.permissions_frame, fg_color="transparent",
            scrollbar_button_color="#1a0010",
            scrollbar_button_hover_color=couleur_permissions)
        self.permissions_scroll.pack(fill="both", expand=True, padx=8, pady=4)

        footer = ctk.CTkFrame(self.permissions_frame, fg_color="#080810", height=40)
        footer.pack(fill="x")
        footer.pack_propagate(False)
        ctk.CTkButton(footer, text="↻ Actualiser", width=100, height=28,
                      fg_color="transparent", hover_color="#1a0010",
                      text_color="#553333", font=("Futura", 9),
                      command=self._refresh_permissions).pack(side="right", padx=12, pady=6)
        self.permissions_frame.bind("<Button-1>", self.click_window)

    def _refresh_permissions(self):
        for w in self.permissions_scroll.winfo_children():
            w.destroy()
        reqs = database.get_pending_requests(None if USER_LEVEL == 0 else USERNAME)
        if not reqs:
            ctk.CTkLabel(self.permissions_scroll, text="Aucune requête en attente ✦",
                         font=("Segoe UI", 11), text_color="#331a1a").pack(pady=30)
            return
        for req in reqs:
            self._add_permission_card(req)

    def _add_permission_card(self, req):
        icons = {"mail_send":"✉","file_organize":"📁","agenda_modify":"📅","rule_create":"⚙","mail_delete":"🗑"}
        icon = icons.get(req.get("type",""), "⚡")
        card = ctk.CTkFrame(self.permissions_scroll, fg_color="#0d0005",
                            corner_radius=14, border_width=1, border_color="#3a0020")
        card.pack(fill="x", padx=8, pady=5)
        tk.Frame(card, bg=couleur_permissions, width=4).pack(side="left", fill="y")
        content = ctk.CTkFrame(card, fg_color="transparent")
        content.pack(side="left", fill="both", expand=True, padx=10, pady=10)
        top = ctk.CTkFrame(content, fg_color="transparent")
        top.pack(fill="x")
        ctk.CTkLabel(top, text=f"{icon}  {req.get('title','?')}",
                     font=("Futura", 11, "bold"), text_color=couleur_permissions).pack(side="left")
        ctk.CTkLabel(top, text=req.get("username",""),
                     font=("Futura", 8), text_color="#553333").pack(side="right")
        ctk.CTkLabel(content, text=req.get("description",""),
                     font=("Segoe UI", 9), text_color="#887777",
                     wraplength=340, justify="left").pack(anchor="w", pady=(2, 6))
        btn_row = ctk.CTkFrame(content, fg_color="transparent")
        btn_row.pack(fill="x")
        req_id = req.get("id")
        ctk.CTkButton(btn_row, text="✔ Accepter", width=100, height=28,
                      fg_color="#1a0010", hover_color="#44ff88",
                      text_color="#44ff88",
                      corner_radius=14, font=("Futura", 9, "bold"),
                      command=lambda r=req_id: self._resolve_req(r, "approved")).pack(side="left", padx=(0,6))
        ctk.CTkButton(btn_row, text="✕ Rejeter", width=90, height=28,
                      fg_color="transparent", hover_color="#330000",
                      text_color="#553333", corner_radius=14, font=("Futura", 9),
                      command=lambda r=req_id: self._resolve_req(r, "rejected")).pack(side="left")

    def _resolve_req(self, req_id, status):
        resolved = database.resolve_permission_request(req_id, status)
        if resolved and status == "approved":
            self._execute_permission_action(resolved)
        self._refresh_permissions()

    def _execute_permission_action(self, req):
        action_type = req.get("type","")
        data = req.get("action_data",{})
        if action_type == "mail_send":
            threading.Thread(target=self.execute_auto_mail,
                             args=(data.get("to"), data.get("subject"), data.get("body")),
                             daemon=True).start()
        elif action_type == "agenda_modify":
            self.add_agenda_event(data.get("title","?"), data.get("date",""),
                                  data.get("time",""), data.get("note",""))

    def _accept_all_permissions(self):
        reqs = database.get_pending_requests(None if USER_LEVEL == 0 else USERNAME)
        for req in reqs:
            resolved = database.resolve_permission_request(req["id"], "approved")
            if resolved:
                self._execute_permission_action(resolved)
        self._show_toast(f"✔ {len(reqs)} requête(s) acceptée(s) et exécutée(s).")
        self._refresh_permissions()

    # ==========================================
    #        RAPPORT JOURNALIER
    # ==========================================
    def _send_daily_report(self):
        if not self.user_email or not self.user_app_pass:
            return
        log = database.load_experience_log()
        today_str = date.today().strftime("%Y-%m-%d")
        if USER_LEVEL == 0:
            entries = [e for e in log if e.get("timestamp","").startswith(today_str)]
            body = f"COMPTE RENDU JOURNALIER — {datetime.now().strftime('%d/%m/%Y')}\nRÉSEAU COMPLET\n\n"
            body += f"Total d'actions : {len(entries)}\n\n"
            by_user = {}
            for e in entries:
                by_user.setdefault(e.get("username","?"), []).append(e)
            for u, elist in by_user.items():
                body += f"── {u} ({len(elist)} actions) ──\n"
                for e in elist:
                    body += f"  • [{e.get('action_type','?')}] {e.get('details','')}\n"
                body += "\n"
        else:
            entries = [e for e in log if e.get("timestamp","").startswith(today_str) and e.get("username")==USERNAME]
            body = f"COMPTE RENDU JOURNALIER — {datetime.now().strftime('%d/%m/%Y')}\n{USERNAME}\n\n"
            body += f"Actions : {len(entries)}\n\n"
            for e in entries:
                body += f"• [{e.get('action_type','?')}] {e.get('details','')}\n"
        try:
            msg = MIMEMultipart()
            msg['From'] = self.user_email
            msg['To'] = self.user_email
            msg['Subject'] = f"Compte rendu journalier — {datetime.now().strftime('%d/%m/%Y')}"
            msg.attach(MIMEText(body, 'plain', 'utf-8'))
            server = smtplib.SMTP('smtp.gmail.com', 587)
            server.starttls()
            server.login(self.user_email, self.user_app_pass)
            server.send_message(msg)
            server.quit()
        except Exception as e:
            print(f"Erreur rapport : {e}")

    # ==========================================
    #        NAVIGATION SUPPLÉMENTAIRE
    # ==========================================
    def toggle_reseau(self):
        if USER_LEVEL > 0:
            self._show_toast("Accès Réseau réservé au Père (niveau 0).")
            return
        if self.mode == "reseau":
            self.root.withdraw(); self.mode = "hidden"
        else:
            self._hide_all_frames()
            self.reseau_frame.pack(fill="both", expand=True)
            w, h = 480, 600
            self.root.geometry(f"{w}x{h}+{(self.sw-w)//2}+{(self.sh-h)//2}")
            self.root.deiconify()
            self.mode = "reseau"
            self._render_reseau()

    def toggle_permissions(self):
        if self.mode == "permissions":
            self.root.withdraw(); self.mode = "hidden"
        else:
            self._hide_all_frames()
            self.permissions_frame.pack(fill="both", expand=True)
            w, h = 460, 600
            self.root.geometry(f"{w}x{h}+{(self.sw-w)//2}+{(self.sh-h)//2}")
            self.root.deiconify()
            self.mode = "permissions"
            self._refresh_permissions()

    # ==========================================
    #        DESSIN & ANIMATIONS
    # ==========================================
    def draw_logo(self, canvas, x, y, size, pulse=0, with_bg=False, color="#22b9ff"):
        canvas.delete("logo")
        scale = 0.85 if self.hub_active_animation and canvas == self.hub_canvas else 1.0
        s = size * scale

        if with_bg:
            # Fond circulaire avec dégradé simulé (deux cercles concentriques)
            canvas.create_oval(x-s-22, y-s-22, x+s+22, y+s+22,
                               fill="#040408", outline="#0c0c18", tags="logo")
            canvas.create_oval(x-s-14, y-s-14, x+s+14, y+s+14,
                               fill="", outline="#1a1a2a", width=1, tags="logo")

        render_color = color if self.logo_alpha > 0.5 else "#222233"

        # Triangle principal
        points = [x, y-s, x+s, y+s, x-s, y+s]
        canvas.create_polygon(points, outline=render_color, fill="", width=2, tags="logo")

        # Triangle intérieur plus fin (effet couche)
        inner_s = s * 0.55
        inner_points = [x, y-inner_s, x+inner_s, y+inner_s, x-inner_s, y+inner_s]
        canvas.create_polygon(inner_points, outline=render_color, fill="",
                              width=1, tags="logo")

        # Point central
        canvas.create_oval(x-2, y-1, x+2, y+3, fill=render_color, outline="", tags="logo")

        if canvas == self.hub_canvas:
            opening_prog = self.hub_dots_progress[0]
            if opening_prog == 0:
                p_size = s + (pulse * 50)
                canvas.create_oval(x-p_size, y-p_size, x+p_size, y+p_size,
                                   outline="#ffffff", width=1, tags="logo")
                # Halo pulsant secondaire plus subtil
                p_size2 = s + (pulse * 30) + 10
                canvas.create_oval(x-p_size2, y-p_size2, x+p_size2, y+p_size2,
                                   outline=render_color, width=1, tags="logo")
            elif opening_prog < 1.0:
                shock_size = s + 40 + (opening_prog * 120)
                canvas.create_oval(x-shock_size, y-shock_size, x+shock_size, y+shock_size,
                                   outline="#442222", width=1, dash=(5, 5), tags="logo")

    def _hub_logo_loop(self):
        """Boucle dédiée à l'animation du logo central du hub."""
        if self.mode != "hub":
            return
        pulse = (math.sin(time.time() * 5) + 1) / 2
        self.draw_logo(self.hub_canvas, self.hub_size//2, self.hub_size//2, 45, pulse,
                       with_bg=True, color=couleur_hub_pale)
        self.root.after(30, self._hub_logo_loop)

    def _refresh_pending_cache(self):
        """Rafraîchit le cache du nombre de permissions en attente (évite appel DB à chaque frame)."""
        try:
            self._pending_count_cache = len(database.get_pending_requests(
                None if USER_LEVEL == 0 else USERNAME))
        except:
            self._pending_count_cache = 0
        if self.mode == "hub":
            self.root.after(5000, self._refresh_pending_cache)

    def update_hub_animation(self):
        target = 1.0 if self.hub_open else 0.0
        changed = False

        for i in range(9):
            if i > 0:
                prev = self.hub_dots_progress[i-1]
                if self.hub_open and prev < 0.2: continue
                if not self.hub_open and prev > 0.8: continue

            if self.hub_dots_progress[i] < target:
                self.hub_dots_progress[i] = min(target, self.hub_dots_progress[i] + HUB_ANIM_SPEED)
                changed = True
            elif self.hub_dots_progress[i] > target:
                self.hub_dots_progress[i] = max(target, self.hub_dots_progress[i] - HUB_ANIM_SPEED)
                changed = True

        # Dessiner
        self.draw_hub_elements()

        still_open = self.hub_open and self.mode == "hub"
        if changed or still_open:
            self.root.after(40, self.update_hub_animation)

    def draw_hub_elements(self):
        self.hub_canvas.delete("menu")
        cx, cy = self.hub_size // 2, self.hub_size // 2

        self.hub_rotation += 1.5
        # Cercle orbital extérieur pointillé (aspect radar)
        self.hub_canvas.create_oval(cx-170, cy-170, cx+170, cy+170,
                                    outline="#1a1a2e", width=1, dash=(2,10), tags="menu")
        self.hub_canvas.create_arc(cx-155, cy-155, cx+155, cy+155,
                                   start=-self.hub_rotation, extent=60,
                                   outline="#ffffff", width=2, style="arc", tags="menu")
        self.hub_canvas.create_arc(cx-162, cy-162, cx+162, cy+162,
                                   start=self.hub_rotation * 0.6, extent=30,
                                   outline="#22b9ff", width=1, style="arc", tags="menu")

        if USER_LEVEL == 0:
            admin_color = couleur_gold
        elif USER_LEVEL == 2:
            admin_color = couleur_permissions
        else:
            admin_color = "#555555"
        reseau_color = couleur_reseau if USER_LEVEL == 0 else "#222222"
        config_options = [
            ("CHAT",    couleur_chat_pale),    # 0
            ("OPTION",  couleur_option_pale),  # 1
            ("ADMIN",   admin_color),          # 2
            ("LOGOUT",  couleur_log_pale),     # 3
            ("INBOX",   couleur_inbox),        # 4
            ("AGENDA",  couleur_agenda),       # 5
            ("RÉSEAU",  reseau_color),         # 6
            ("PERMS",   couleur_permissions),  # 7
            ("MAIL",    couleur_mail_pale),    # 8
        ]

        nb = len(config_options)
        radius_max = 150
        # pending_count mis en cache (rafraîchi via _refresh_pending_cache)
        pending_count = getattr(self, "_pending_count_cache", 0)
        # Pulse global pour halos
        glow_pulse = (math.sin(time.time() * 2.2) + 1) / 2  # 0..1

        for i in range(nb):
            prog = self.hub_dots_progress[i]
            if prog <= 0: continue

            nom, col = config_options[i]
            angle = math.radians(i * (360 / nb) - 90)
            cur_r = prog * radius_max
            x = cx + cur_r * math.cos(angle)
            y = cy + cur_r * math.sin(angle)

            # Ligne centre → orbe
            self.hub_canvas.create_line(cx, cy, x, y, fill="#1a1a2a", width=1, tags="menu")

            # Particule qui remonte le long de la ligne (effet flux)
            flow_pos = (time.time() * 1.5 + i * 0.2) % 1.0
            fx = cx + (cur_r * flow_pos) * math.cos(angle)
            fy = cy + (cur_r * flow_pos) * math.sin(angle)
            self.hub_canvas.create_oval(fx-1.5, fy-1.5, fx+1.5, fy+1.5,
                                        fill=col, outline="", tags="menu")

            opt_size = 28 * prog

            # Halo externe pulsant (seulement quand orbe quasi en place)
            if prog > 0.85:
                halo_size = opt_size + 5 + (glow_pulse * 4)
                self.hub_canvas.create_oval(x-halo_size, y-halo_size, x+halo_size, y+halo_size,
                                            outline=col, width=1, tags="menu")

            # Orbe principal (fond + bordure)
            self.hub_canvas.create_oval(x-opt_size, y-opt_size, x+opt_size, y+opt_size,
                                        fill="#050510", outline=col, width=2, tags="menu")

            # Texte uniquement quand l'orbe est ouvert à >80%
            if prog > 0.8:
                self.hub_canvas.create_text(x, y-5, text=nom, fill=col,
                                            font=("Verdana", 7, "bold"), tags="menu")
                if nom == "PERMS" and pending_count > 0:
                    self.hub_canvas.create_oval(x+18, y-22, x+30, y-10,
                                                fill=couleur_permissions, outline="", tags="menu")
                    self.hub_canvas.create_text(x+24, y-16, text=str(pending_count),
                                                fill="#000", font=("Arial", 7, "bold"), tags="menu")
                else:
                    self.hub_canvas.create_text(x, y+12, text="●", fill=col,
                                                font=("Arial", 6), tags="menu")

    def hub_click_event(self, event):
        cx, cy = self.hub_size // 2, self.hub_size // 2
        dist = math.sqrt((event.x - cx)**2 + (event.y - cy)**2)

        if dist < 60:
            self.hub_active_animation = True
            self.root.after(150, lambda: setattr(self, 'hub_active_animation', False))
            self.hub_open = not self.hub_open
            self._refresh_pending_cache()
            self.update_hub_animation()
            return

        if self.hub_open:
            nb = 9
            radius = 150
            for i in range(nb):
                angle = math.radians(i * (360 / nb) - 90)
                ox = cx + radius * math.cos(angle)
                oy = cy + radius * math.sin(angle)
                if math.sqrt((event.x - ox)**2 + (event.y - oy)**2) < 40:
                    if   i == 0: self.toggle_chat()
                    elif i == 1: self.toggle_options()
                    elif i == 2:
                        if USER_LEVEL == 0: self.toggle_admin()
                        else: self.toggle_permissions()
                    elif i == 3: self.logout()
                    elif i == 4: self.toggle_inbox()
                    elif i == 5: self.toggle_agenda()
                    elif i == 6: self.toggle_reseau()
                    elif i == 7: self.toggle_permissions()
                    elif i == 8: self.toggle_mail()
                    break

    def animate(self):
        now = time.time()
        self.pulse_val = (math.sin(now * 5) + 1) / 2

        if self.mode == "bubble":
            self.pos_x += self.speed_x
            self.pos_y += self.speed_y
            if self.pos_x <= 0 or self.pos_x >= self.sw - self.bubble_win_size:
                self.speed_x *= -1
            if self.pos_y <= 0 or self.pos_y >= self.sh - self.bubble_win_size:
                self.speed_y *= -1
            self.root.geometry(f"+{int(self.pos_x)}+{int(self.pos_y)}")
            self.draw_logo(self.bubble_canvas, 70, 70, 40, self.pulse_val,
                           with_bg=True, color=couleur_bubble_pale)

        elif self.mode == "chat":
            self.draw_logo(self.header_logo_canvas, 20, 20, 12, self.pulse_val,
                           with_bg=False, color=couleur_chat_pale)

        elif self.mode == "hub":
            self.draw_logo(self.hub_canvas, self.hub_size//2, self.hub_size//2, 45, self.pulse_val,
                           with_bg=True, color=couleur_hub_pale)

        self.root.after(16, self.animate)

    def update_speed(self, val):
        self.bubble_speed = int(val)
        self.speed_x = self.bubble_speed if self.speed_x > 0 else -self.bubble_speed
        self.speed_y = self.bubble_speed if self.speed_y > 0 else -self.bubble_speed

    # ==========================================
    #        DÉPLACEMENT FENÊTRE
    # ==========================================
    def click_window(self, event):
        self._offsetx, self._offsety = event.x, event.y

    def drag_window(self, event):
        if self.mode != "hidden":
            x = self.root.winfo_pointerx() - self._offsetx
            y = self.root.winfo_pointery() - self._offsety
            self.root.geometry(f"+{x}+{y}")


# ==========================================
if __name__ == "__main__":
    app = AssistantApp()
    app.root.mainloop()
